# Server
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mass_spec_scheduler
JWT_SECRET=change-me-to-a-long-random-secret

# Storage / sequence files
S3_PROVIDER=local

# Optional S3 provider (when S3_PROVIDER=s3)
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=mass-spec-sequences
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PATH_PREFIX=lcms-sequences/

# Optional default admin seed on first startup
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123

# Frontend build-time (dev proxy target)
# VITE_API_URL=
